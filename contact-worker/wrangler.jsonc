{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "jsp-contact",
    "main": "worker.mjs",
    "compatibility_date": "2026-10-01",
    "workers_dev": true,
    "vars": {
        "ALLOWED_ORIGINS": "https://www.jspcreditmanagement.co.uk,https://jspcreditmanagement.co.uk",
        "TURNSTILE_HOSTNAMES": "www.jspcreditmanagement.co.uk,jspcreditmanagement.co.uk"
    },
    "ratelimits": [
        {
            "name": "CONTACT_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 3,
                "period": 60
            }
        }
    ]
}
